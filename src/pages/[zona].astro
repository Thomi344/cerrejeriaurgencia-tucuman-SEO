---
// src/pages/[zona].astro
import type { GetStaticPaths } from 'astro';

import Layout from '../layouts/Layout.astro';
import { zonas, slugZona } from '../data/zonas';

import Header from '../sections/Header.astro';
import Hero from '../sections/Hero.astro';
import Servicios from '../sections/Servicios.astro';
import Beneficios from '../sections/Beneficios.astro';
import Opiniones from '../sections/Opiniones.astro';
import Galeria from '../sections/Galeria.astro';
import Faq from '../sections/Faq.astro';
import Footer from '../sections/Footer.astro';

// --- Mapeamos cada zona y cada uno de sus barrios a su propia página ---
// Ej: /cerrajero-zona-yerba-buena y /cerrajero-zona-barrio-norte
export const getStaticPaths = (() =>
    zonas.flatMap((zonaData) =>
        [zonaData.nombre, ...zonaData.barrios].map((nombreDinamico) => ({
            params: { zona: slugZona(nombreDinamico) },
            props: { infoZona: { ...zonaData, nombreDinamico } },
        }))
    )
) satisfies GetStaticPaths;

// --- Recibimos la información de la zona en la que estamos parados ---
const { infoZona } = Astro.props;
---

<Layout
    title={`Cerrajero de Urgencia en ${infoZona.nombreDinamico} | 24 Horas | Cerrajería Tucumán`}
    description={`¿Necesitás un cerrajero rápido en ${infoZona.nombreDinamico}? Apertura de autos, casas y cajas fuertes las 24hs. Servicio garantizado en ${infoZona.region}.`}
    nombreZona={infoZona.nombreDinamico}
>

    <Header nombreZona={infoZona.nombreDinamico} />
    <Hero
        nombreZona={infoZona.nombreDinamico}
        region={infoZona.region}
        barrios={infoZona.barrios}
    />
    <Servicios nombreZona={infoZona.nombreDinamico} />
    <Beneficios nombreZona={infoZona.nombreDinamico} />
    <Opiniones nombreZona={infoZona.nombreDinamico} />
    <Galeria nombreZona={infoZona.nombreDinamico} />
    <Faq nombreZona={infoZona.nombreDinamico} />
    <Footer />
</Layout>
