---
// src/components/CookieBanner.astro
---

<!-- Banner tipo "Toast" (Franja inferior en mobile, recuadro minimalista en desktop) -->
<div 
    id="cookie-banner" 
    class="fixed bottom-0 left-0 w-full md:bottom-6 md:left-6 md:w-auto md:max-w-sm z-[100] transform transition-all duration-500 translate-y-full opacity-0 hidden"
>
    <div class="bg-fondo-nav/95 backdrop-blur-xl border-t md:border border-borde p-3 md:p-4 md:rounded-xl shadow-[0_-5px_20px_rgba(0,0,0,0.5)] flex items-center justify-between gap-4">
        
        <!-- Texto del Banner (Corto y directo) -->
        <p class="text-[10px] md:text-xs text-gray-300 leading-tight m-0">
            Usamos cookies para mejorar tu experiencia. Al continuar navegando, aceptas su uso. 
            <a href="/politica-de-cookies" class="text-marca hover:underline font-medium ml-1">Ver detalles</a>.
        </p>

        <!-- Único Botón de Acción -->
        <button 
            id="btn-ok-cookies"
            type="button"
            class="flex-shrink-0 bg-marca hover:bg-marca/90 text-white text-[10px] md:text-xs font-bold py-1.5 px-4 rounded-md transition-all shadow-[0_0_10px_rgba(14,165,233,0.2)] hover:shadow-[0_0_15px_rgba(14,165,233,0.4)] focus:outline-none"
        >
            OK
        </button>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const banner = document.getElementById('cookie-banner');
        const btnOk = document.getElementById('btn-ok-cookies');
        const cookieStorageKey = 'cerrajeria_tucuman_cookie_consent';

        // Evitar doble ejecución si ya existe el consentimiento
        if (localStorage.getItem(cookieStorageKey)) return;

        // Mostrar el banner si no hay consentimiento guardado
        if (banner) {
            banner.classList.remove('hidden');
            setTimeout(() => {
                banner.classList.remove('translate-y-full', 'opacity-0');
            }, 100);
        }

        const acceptCookies = () => {
            if (localStorage.getItem(cookieStorageKey)) return; // Prevenir múltiples disparos
            
            // Guardar decisión en el navegador
            localStorage.setItem(cookieStorageKey, 'accepted');
            
            // Lógica de Google Consent Mode v2 (Activar scripts)
            if (typeof (window as any).gtag === 'function') {
                (window as any).gtag('consent', 'update', {
                    'analytics_storage': 'granted',
                    'ad_storage': 'granted',
                    'ad_user_data': 'granted',
                    'ad_personalization': 'granted'
                });
            }
            
            // Ocultar banner con animación
            if (banner) {
                banner.classList.add('translate-y-full', 'opacity-0');
                setTimeout(() => {
                    banner.classList.add('hidden');
                }, 500); 
            }

            // Limpiar los event listeners implícitos para no consumir recursos
            window.removeEventListener('scroll', handleScroll);
            document.removeEventListener('click', handleInteraction);
        };

        // 1. Aceptación explícita (Clic en el botón OK)
        if (btnOk) btnOk.addEventListener('click', acceptCookies);

        // 2. Aceptación implícita por Scroll (Si baja más de 150px)
        const handleScroll = () => {
            if (window.scrollY > 150) {
                acceptCookies();
            }
        };
        window.addEventListener('scroll', handleScroll, { passive: true });

        // 3. Aceptación implícita por Interacción (Si hace clic en cualquier enlace de la web)
        const handleInteraction = (e: MouseEvent) => {
            // Si el clic NO fue dentro del banner, asumimos navegación normal y aceptamos
            if (banner && !banner.contains(e.target as Node)) {
                acceptCookies();
            }
        };
        document.addEventListener('click', handleInteraction);
    });
</script>