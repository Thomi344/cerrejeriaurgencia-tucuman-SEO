---
// src/sections/Header.astro
import WhatsappIcon from '../components/WhatsappIcon.astro';
import { urlWhatsapp } from '../utils/contacto';

interface Props {
    nombreZona?: string;
    // En páginas sin las secciones de la landing (404, legales, directorio) las anclas apuntan al inicio
    enlacesAlInicio?: boolean;
}

const { nombreZona = "Tucumán", enlacesAlInicio = false } = Astro.props;

// Construcción del enlace dinámico
const urlWpp = urlWhatsapp(`Hola, entré a la web y necesito un cerrajero en ${nombreZona}`);

const base = enlacesAlInicio ? '/' : '';
const enlaces = [
    { href: `${base}#servicios`, texto: 'Servicios' },
    { href: `${base}#trabajos`, texto: 'Trabajos Realizados' },
    { href: `${base}#resenas`, texto: 'Reseñas' },
];
---

<header class="sticky top-0 z-50 w-full bg-fondo-nav border-b border-borde shadow-[0_4px_6px_-1px_rgba(0,0,0,0.5)] flex flex-col">

    <!-- Top Bar: Banner de Urgencia -->
    <div class="bg-marca w-full py-1.5 md:py-2 px-4 text-center">
        <span class="text-white text-[10px] md:text-sm font-black uppercase tracking-[0.2em] md:tracking-[0.3em]">
            Urgencias las 24 Horas
        </span>
    </div>

    <!-- Contenedor Principal del Header -->
    <div class="max-w-[1536px] w-full mx-auto px-4 py-3 md:px-8 md:py-4 flex justify-between items-center gap-2">

        <!-- Izquierda: Logo y Zona (el título principal de cada página está en su propio contenido) -->
        <a href="/" class="flex flex-col shrink-0 group">
            <span class="font-black text-2xl md:text-4xl text-white leading-none tracking-tight transition-transform group-hover:scale-[1.02] origin-left">
                Cerrajería <span class="text-marca-suave">Tucumán</span>
            </span>
            <span class="text-xs md:text-sm font-bold text-gray-300 uppercase tracking-widest mt-1 md:mt-1.5">
                En {nombreZona}
            </span>
        </a>

        <!-- Centro: Navegación de PC -->
        <nav class="hidden md:flex items-center gap-6 lg:gap-8">
            {enlaces.map((enlace) => (
                <a href={enlace.href} class="text-xs lg:text-sm font-black text-white hover:text-marca-suave uppercase tracking-widest transition-colors">{enlace.texto}</a>
            ))}
        </nav>

        <!-- Derecha: Botón WhatsApp (PC) y Menú Hamburguesa (Mobile) -->
        <div class="flex items-center shrink-0">
            <!-- CTA WhatsApp: Visible solo en Desktop (registra la conversión y abre en pestaña nueva) -->
            <a
                href={urlWpp}
                target="_blank"
                rel="noopener noreferrer"
                onclick="gtag_report_conversion();"
                class="hidden md:flex bg-[#25D366] hover:bg-[#128C7E] text-white px-5 py-2.5 lg:px-7 lg:py-3.5 rounded-xl font-black items-center gap-2 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.5)] hover:-translate-y-0.5 transition-all duration-300 active:scale-95"
            >
                <WhatsappIcon class="w-5 h-5 lg:w-6 lg:h-6" />
                <span class="text-sm lg:text-base tracking-wide">Contactar Ya</span>
            </a>

            <!-- Botón Hamburguesa: Visible solo en Mobile -->
            <button id="btn-hamburguesa" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-mobile" class="md:hidden text-white p-1 focus:outline-none hover:text-marca-suave transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Menú Desplegable Mobile (Oculto por defecto) -->
    <div id="menu-mobile" class="hidden flex-col bg-fondo-card border-t border-borde md:hidden shadow-inner">
        {enlaces.map((enlace) => (
            <a href={enlace.href} class="px-6 py-4 text-white font-bold text-sm uppercase tracking-widest border-b border-borde/50 hover:bg-borde/30">{enlace.texto}</a>
        ))}

        <!-- Botón de WhatsApp movido al fondo de los textos en Mobile -->
        <div class="p-5 bg-fondo-card">
            <a
                href={urlWpp}
                target="_blank"
                rel="noopener noreferrer"
                onclick="gtag_report_conversion();"
                class="bg-[#25D366] hover:bg-[#128C7E] text-white w-full py-4 rounded-xl font-black flex justify-center items-center gap-2 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.5)] active:scale-95 transition-transform"
            >
                <WhatsappIcon class="w-6 h-6" />
                <span class="text-base tracking-wide">Contactar Ya</span>
            </a>
        </div>
    </div>
</header>

<script>
    const btnHamburguesa = document.getElementById('btn-hamburguesa');
    const menuMobile = document.getElementById('menu-mobile');

    if (btnHamburguesa && menuMobile) {
        const setMenuAbierto = (abierto: boolean) => {
            menuMobile.classList.toggle('hidden', !abierto);
            menuMobile.classList.toggle('flex', abierto);
            btnHamburguesa.setAttribute('aria-expanded', String(abierto));
        };

        btnHamburguesa.addEventListener('click', () => {
            setMenuAbierto(menuMobile.classList.contains('hidden'));
        });

        menuMobile.querySelectorAll('a').forEach(enlace => {
            enlace.addEventListener('click', () => setMenuAbierto(false));
        });
    }
</script>
