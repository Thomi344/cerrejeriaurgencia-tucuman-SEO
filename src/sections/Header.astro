---
// src/sections/Header.astro

interface Props {
    nombreZona?: string;
}

const { nombreZona = "Tucumán" } = Astro.props;

// Construcción del enlace dinámico
const telefono = import.meta.env.PUBLIC_TELEPHONE?.replace('+', '') || "5493810000000";
const mensaje = `Hola, entré a la web y necesito un cerrajero en ${nombreZona}`;
const urlWpp = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
---

<header class="sticky top-0 z-50 w-full bg-fondo-nav border-b border-borde shadow-[0_4px_6px_-1px_rgba(0,0,0,0.5)] flex flex-col">
    
    <!-- Top Bar: Banner de Urgencia -->
    <div class="bg-marca w-full py-1.5 md:py-2 px-4 text-center">
        <span class="text-white text-[10px] md:text-sm font-black uppercase tracking-[0.2em] md:tracking-[0.3em]">
            Urgencias las 24 Horas
        </span>
    </div>

    <!-- Contenedor Principal del Header -->
    <div class="max-w-[1536px] w-full mx-auto px-4 py-3 md:px-8 md:py-4 flex justify-between items-center gap-2">
        
        <!-- Izquierda: Logo y Zona (Limpio, solo el nombre del barrio debajo) -->
        <a href="/" class="flex flex-col shrink-0 group">
            <h1 class="font-black text-2xl md:text-4xl text-white leading-none tracking-tight transition-transform group-hover:scale-[1.02] origin-left">
                Cerrajería <span class="text-marca-suave">Tucumán</span>
            </h1>
            <span class="text-xs md:text-sm font-bold text-gray-300 uppercase tracking-widest mt-1 md:mt-1.5">
                En {nombreZona}
            </span>
        </a>

        <!-- Centro: Navegación de PC -->
        <nav class="hidden md:flex items-center gap-6 lg:gap-8">
            <a href="#servicios" class="text-xs lg:text-sm font-black text-white hover:text-marca-suave uppercase tracking-widest transition-colors">Servicios</a>
            <a href="#trabajos" class="text-xs lg:text-sm font-black text-white hover:text-marca-suave uppercase tracking-widest transition-colors">Trabajos Realizados</a>
            <a href="#resenas" class="text-xs lg:text-sm font-black text-white hover:text-marca-suave uppercase tracking-widest transition-colors">Reseñas</a>
        </nav>

        <!-- Derecha: Botón WhatsApp (PC) y Menú Hamburguesa (Mobile) -->
        <div class="flex items-center shrink-0">
            <!-- CTA WhatsApp: Visible solo en Desktop -->
            <a 
                href={urlWpp} 
                target="_blank" 
                rel="noopener noreferrer" 
                onclick="gtag('event', 'conversion', {'send_to': 'AW-XXXXXXXXXX/TU_CODIGO_DE_CONVERSION'});"
                class="hidden md:flex bg-[#25D366] hover:bg-[#128C7E] text-white px-5 py-2.5 lg:px-7 lg:py-3.5 rounded-xl font-black items-center gap-2 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.5)] hover:-translate-y-0.5 transition-all duration-300 active:scale-95"
            >
                <svg class="w-5 h-5 lg:w-6 lg:h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span class="text-sm lg:text-base tracking-wide">Contactar Ya</span>
            </a>
            
            <!-- Botón Hamburguesa: Visible solo en Mobile -->
            <button id="btn-hamburguesa" aria-label="Abrir menú" class="md:hidden text-white p-1 focus:outline-none hover:text-marca-suave transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Menú Desplegable Mobile (Oculto por defecto) -->
    <div id="menu-mobile" class="hidden flex-col bg-fondo-card border-t border-borde md:hidden shadow-inner">
        <a href="#servicios" class="px-6 py-4 text-white font-bold text-sm uppercase tracking-widest border-b border-borde/50 hover:bg-borde/30">Servicios</a>
        <a href="#trabajos" class="px-6 py-4 text-white font-bold text-sm uppercase tracking-widest border-b border-borde/50 hover:bg-borde/30">Trabajos Realizados</a>
        <a href="#resenas" class="px-6 py-4 text-white font-bold text-sm uppercase tracking-widest border-b border-borde/50 hover:bg-borde/30">Reseñas</a>
        
        <!-- Botón de WhatsApp movido al fondo de los textos en Mobile -->
        <div class="p-5 bg-fondo-card">
            <a 
                href={urlWpp} 
                target="_blank" 
                rel="noopener noreferrer" 
                onclick="gtag('event', 'conversion', {'send_to': 'AW-XXXXXXXXXX/TU_CODIGO_DE_CONVERSION'});"
                class="bg-[#25D366] hover:bg-[#128C7E] text-white w-full py-4 rounded-xl font-black flex justify-center items-center gap-2 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.5)] active:scale-95 transition-transform"
            >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span class="text-base tracking-wide">Contactar Ya</span>
            </a>
        </div>
    </div>
</header>

<script>
    const btnHamburguesa = document.getElementById('btn-hamburguesa');
    const menuMobile = document.getElementById('menu-mobile');

    if (btnHamburguesa && menuMobile) {
        btnHamburguesa.addEventListener('click', () => {
            menuMobile.classList.toggle('hidden');
            menuMobile.classList.toggle('flex');
        });

        const enlacesMobile = menuMobile.querySelectorAll('a');
        enlacesMobile.forEach(enlace => {
            enlace.addEventListener('click', () => {
                menuMobile.classList.add('hidden');
                menuMobile.classList.remove('flex');
            });
        });
    }
</script>