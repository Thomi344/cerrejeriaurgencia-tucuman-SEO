---
// src/sections/Beneficios.astro

interface Props {
    nombreZona?: string;
}

const { nombreZona = "Tucumán" } = Astro.props;

// Array de beneficios con copy optimizado para escaneo (scanning)
const beneficios = [
    {
        titulo: "Llegamos en 20 Minutos",
        descripcion: `Sabemos que tu tiempo vale. Tenemos móviles estratégicamente ubicados en ${nombreZona} para resolver tu urgencia <strong class="text-white font-black">en tiempo récord, sin esperas eternas.</strong>`,
        // Icono de Rayo/Velocidad (Grosor aumentado a stroke-width="2.5")
        icono: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`
    },
    {
        titulo: "Aperturas Sin Roturas",
        descripcion: `No rompemos tu cerradura. Utilizamos herramientas ganzúa de última generación y técnicas de precisión para abrir puertas y vehículos <strong class="text-white font-black">sin causar daños.</strong>`,
        // Icono de Escudo/Seguridad (Grosor aumentado a stroke-width="2.5")
        icono: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`
    },
    {
        titulo: "Atención Real 24/7",
        descripcion: `<strong class="text-white font-black">Domingos, feriados o a las 3 AM.</strong> Si te quedaste afuera, contamos con personal de guardia permanente y aceptamos múltiples medios de pago.`,
        // Icono de Reloj/24hs (Grosor aumentado a stroke-width="2.5")
        icono: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
    }
];
---

<section class="py-20 md:py-28 bg-fondo-base relative overflow-hidden">
    
    <!-- Elementos decorativos de fondo (Glow) -->
    <div class="absolute top-0 right-0 -mt-20 -mr-20 w-72 h-72 bg-marca-suave/5 rounded-full blur-[80px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-72 h-72 bg-marca/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- H2 optimizado para SEO y Miedo al Precio -->
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
            <h2 class="text-3xl md:text-5xl font-black text-white leading-tight tracking-tight mb-4">
                Cerrajería de Confianza en <br class="hidden sm:block" />
                <span class="text-marca">{nombreZona}</span>
            </h2>
            <p class="text-gray-300 text-base md:text-xl font-medium">
                Soluciones rápidas con <strong class="text-white font-bold">precios claros</strong>. Presupuesto sin sorpresas antes de empezar el trabajo.
            </p>
        </div>

        <!-- Grid de Beneficios con alineación 'stretch' implícita en grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
            {beneficios.map((beneficio) => (
                <div class="flex flex-col h-full bg-fondo-card/40 backdrop-blur-sm border border-borde rounded-2xl p-8 hover:-translate-y-2 hover:border-marca hover:bg-fondo-card hover:shadow-2xl hover:shadow-marca/10 transition-all duration-300 group">
                    
                    <!-- Icono destacado (Fondo celeste transparente, ícono vibrante) -->
                    <div class="w-20 h-20 rounded-2xl bg-marca/10 flex items-center justify-center text-marca-suave mb-6 group-hover:scale-110 group-hover:bg-marca/20 transition-all duration-300">
                        <Fragment set:html={beneficio.icono} />
                    </div>
                    
                    <!-- Textos del beneficio -->
                    <h3 class="text-xl md:text-2xl font-bold text-white mb-4 tracking-wide group-hover:text-marca-suave transition-colors">
                        {beneficio.titulo}
                    </h3>
                    <p class="text-gray-400 leading-relaxed text-base md:text-sm lg:text-base flex-grow">
                        <!-- Usamos Fragment para renderizar correctamente las etiquetas <strong> del array -->
                        <Fragment set:html={beneficio.descripcion} />
                    </p>
                    
                </div>
            ))}
        </div>
        
    </div>
</section>