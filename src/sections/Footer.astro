---
// src/sections/Footer.astro
import { telefono, telefonoTel } from '../utils/contacto';
import { slugZona } from '../data/zonas';

const zonasDestacadas = ['San Miguel de Tucumán', 'Yerba Buena', 'Tafí Viejo', 'Banda del Río Salí'];
---

<footer class="bg-fondo-base border-t border-borde relative overflow-hidden">
    
    <!-- Patrón de fondo (Sutil) -->
    <div class="absolute inset-0 bg-[radial-gradient(#4b5563_1px,transparent_1px)] [background-size:24px_24px] opacity-10 pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 relative z-10">
        
        <!-- Grid de Columnas -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
            
            <!-- Columna 1: Marca y Descripción -->
            <div class="md:col-span-5 lg:col-span-4">
                <p class="text-2xl font-black text-white mb-4 tracking-tight">
                    Cerrajería <span class="text-marca">Tucumán</span>
                </p>
                <p class="text-gray-300 text-sm md:text-base leading-relaxed pr-4">
                    Especialistas en aperturas de puertas, autos y cajas fuertes. Servicio de urgencia 24 horas rápido, limpio y garantizado en todo el Gran Tucumán.
                </p>
            </div>

            <!-- Columna 2: Contacto -->
            <div class="md:col-span-3 lg:col-span-4 lg:col-start-6">
                <p class="text-white font-bold mb-6 text-sm uppercase tracking-wider">Contacto</p>
                
                <div class="space-y-6">
                    <!-- Teléfono Destacado -->
                    <a href={`tel:${telefonoTel}`} class="flex items-start gap-4 group">
                        <svg class="w-6 h-6 md:w-7 md:h-7 text-marca flex-shrink-0 mt-1 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        <div>
                            <p class="text-gray-400 text-sm mb-1">Urgencias 24hs:</p>
                            <p class="text-white font-black text-xl md:text-2xl tracking-tight group-hover:text-marca transition-colors">{telefono}</p>
                        </div>
                    </a>
                    
                    <!-- Horarios -->
                    <div class="flex items-start gap-4">
                        <svg class="w-6 h-6 md:w-7 md:h-7 text-marca flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <div>
                            <p class="text-white font-bold text-base mb-1">Lunes a Domingos</p>
                            <p class="text-gray-400 text-sm">Atención ininterrumpida</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna 3: Zonas de Cobertura -->
            <div class="md:col-span-4 lg:col-span-3 lg:col-start-10">
                <p class="text-white font-bold mb-6 text-sm uppercase tracking-wider">Zonas de Cobertura</p>

                <ul class="space-y-4 mb-6">
                    {zonasDestacadas.map((zona) => (
                        <li class="text-sm md:text-base text-gray-300">
                            <a href={`/${slugZona(zona)}/`} class="flex items-center gap-3 hover:text-marca transition-colors">
                            <svg class="w-5 h-5 text-marca flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            <span>{zona}</span>
                            </a>
                        </li>
                    ))}
                </ul>

                <!-- Botón hacia el directorio de zonas indexables -->
                <div class="pt-3 border-t border-borde/50 inline-block w-full">
                    <a href="/zonas-de-cobertura" class="inline-flex items-center gap-2 text-marca text-sm font-bold hover:text-marca-suave transition-colors group uppercase tracking-wide">
                        Ver zonas de cobertura
                        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                </div>
            </div>

        </div>

        <!-- Barra Inferior (Copyright y Legales) -->
        <!-- Se agregó pr-20 en mobile/tablet para que el botón de WhatsApp flotante no tape el contenido -->
        <div class="mt-16 pt-8 border-t border-borde flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 pr-20 lg:pr-0 pb-6 md:pb-0">
            
            <p class="text-gray-400 text-xs text-left">
                © {new Date().getFullYear()} Cerrajería Tucumán. Todos los derechos reservados.
            </p>
            
            <!-- Enlaces Legales con separador de punto (•) -->
            <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-gray-400">
                <a href="/politica-de-privacidad" class="hover:text-marca transition-colors">Privacidad</a>
                <span class="text-gray-600 hidden sm:inline">•</span>
                <a href="/terminos-y-condiciones" class="hover:text-marca transition-colors">Términos y Condiciones</a>
                <span class="text-gray-600 hidden sm:inline">•</span>
                <a href="/politica-de-cookies" class="hover:text-marca transition-colors">Cookies</a>
            </div>

            <p class="text-gray-400 text-xs flex items-center gap-1 text-left">
                Desarrollado con Astro <span class="text-base">🚀</span>
            </p>

        </div>

    </div>
</footer>