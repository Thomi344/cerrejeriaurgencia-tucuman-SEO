---
// src/sections/Hero.astro
import { Image } from 'astro:assets';
import heroBg from '../assets/images/hero-bg.webp'; 

interface Props {
    nombreZona?: string;
    region?: string;
    barrios?: string[];
}

const { 
    nombreZona = "Tucumán", 
    region = "Tucumán", 
    barrios = ["Yerba Buena", "Barrio Norte", "Tafí Viejo", "Barrio Sur"] 
} = Astro.props;

// Construcción del enlace dinámico de WhatsApp
const telefono = import.meta.env.PUBLIC_TELEPHONE?.replace('+', '') || "5493810000000";
const mensaje = `Hola, entré a la web y necesito un cerrajero de urgencia en ${nombreZona}`;
const urlWpp = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
---

<section class="relative min-h-[85vh] flex flex-col justify-center overflow-hidden bg-fondo-base pt-12 pb-20 md:pt-20 md:pb-28">
    
    <!-- Imagen de fondo optimizada con astro:assets -->
    <Image 
        src={heroBg} 
        alt={`Cerrajería de urgencia en ${nombreZona}`} 
        widths={[640, 1024, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
    />

    <!-- Capa de oscurecimiento (Overlay) para contraste de textos -->
    <div class="absolute inset-0 bg-gradient-to-b from-fondo-base/90 via-fondo-base/80 to-fondo-base"></div>

    <!-- Contenedor del contenido -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 text-center flex flex-col items-center">
        
        <!-- Insignia de Urgencia -->
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-marca/10 border border-marca/30 text-marca-suave text-xs md:text-sm font-black uppercase tracking-[0.2em] mb-6">
            <span class="w-2 h-2 rounded-full bg-wpp animate-ping"></span>
            Atención Inmediata 24/7
        </span>

        <!-- Título Principal H1 enfocado en SEO local -->
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-white tracking-tighter leading-none mb-6 max-w-4xl">
            Cerrajero de Urgencia en <br class="sm:hidden" /><span class="text-marca-suave underline decoration-marca/40 underline-offset-8">{nombreZona}</span>
        </h1>

        <!-- Texto semántico con palabras clave y cobertura local -->
        <div class="text-gray-200 text-base sm:text-lg md:text-xl font-normal leading-relaxed max-w-3xl mb-10 space-y-3">
            <p>
                Servicio integral de cerrajería en <strong class="text-white font-bold">{region}</strong>. Cobertura rápida y móvil en 
                <span class="text-gray-300 font-medium">
                    {barrios.slice(0, 5).join(', ')} y zonas aledañas.
                </span>
            </p>
            <p class="text-sm sm:text-base text-gray-300">
                Especialistas en <strong class="text-white font-semibold">aperturas sin romper</strong>, cambio de combinaciones, cerraduras de alta seguridad y cerrajería automotor las 24 horas.
            </p>
        </div>

        <!-- Grupo de CTAs: Botón WhatsApp + Botón Servicios -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full max-w-md sm:max-w-none">
            
            <!-- Botón Principal: WhatsApp Directo -->
            <a 
                href={urlWpp} 
                target="_blank" 
                rel="noopener noreferrer" 
                onclick="gtag('event', 'conversion', {'send_to': 'AW-XXXXXXXXXX/TU_CODIGO_DE_CONVERSION'});"
                class="w-full sm:w-auto bg-[#25D366] hover:bg-[#128C7E] text-white px-8 py-4 rounded-xl font-black text-lg flex items-center justify-center gap-3 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.5)] hover:-translate-y-0.5 transition-all duration-300 active:scale-95"
            >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span>Pedir Cerrajero Ya</span>
            </a>

            <!-- Botón Secundario: Ver Servicios -->
            <a 
                href="#servicios" 
                class="w-full sm:w-auto bg-fondo-card/80 hover:bg-fondo-card text-white border border-borde px-8 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 transition-all duration-300 hover:border-marca/50"
            >
                <span>Ver Servicios</span>
                <svg class="w-5 h-5 text-marca-suave" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </a>

        </div>

    </div>
</section>