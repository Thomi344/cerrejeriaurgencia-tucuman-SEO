---
// src/sections/Galeria.astro
import { Image } from 'astro:assets';

// Importamos exactamente las imágenes que tenés en tu carpeta
import galeria1 from '../assets/images/Galeria1.webp';
import galeria2 from '../assets/images/Galeria2.webp';
import galeria3 from '../assets/images/Galeria3.webp';
import tiktok1 from '../assets/images/ImagenTikTok1.webp';
import tiktok2 from '../assets/images/ImagenTikTok2.webp';
import tiktok3 from '../assets/images/ImagenTikTok3.webp';

interface Props {
    nombreZona?: string;
}
const { nombreZona = "Tucumán" } = Astro.props;

// Array estructurado con las 6 piezas de contenido
const trabajos = [
    {
        tipo: 'video',
        src: tiktok1,
        alt: 'Instalación de cerradura electrónica',
        etiqueta: 'Instalación de cerradura electrónica',
        mediaUrl: 'https://res.cloudinary.com/dcjy0mij8/video/upload/v1788828891/snaptik_7654740747907779858_v3_he27wf.mp4'
    },
    {
        tipo: 'foto',
        src: galeria1,
        alt: 'Codificación de llaves navaja con telemando y escáner de cerrajería automotriz en Tucumán',
        etiqueta: 'Cerrajería del automotor y telemandos',
        mediaUrl: galeria1.src 
    },
    {
        tipo: 'video',
        src: tiktok2,
        alt: 'Instalaciones en el día',
        etiqueta: 'Instalaciones en el día',
        mediaUrl: 'https://res.cloudinary.com/dcjy0mij8/video/upload/v1788828891/snaptik_7674451730754440455_v3_jkgyxd.mp4'
    },
    {
        tipo: 'foto',
        src: galeria2,
        alt: 'Escáner automotriz programando llave con chip y telemando de auto en Tucumán',
        etiqueta: 'Programación y copias de llaves',
        mediaUrl: galeria2.src
    },
    {
        tipo: 'video',
        src: tiktok3,
        alt: 'Apertura vehicular',
        etiqueta: 'Apertura vehicular',
        mediaUrl: 'https://res.cloudinary.com/dcjy0mij8/video/upload/v1775086772/video-1-tik-tok_txREvfCQ_ejphn6.mp4'
    },
    {
        tipo: 'foto',
        src: galeria3,
        alt: `Técnico cerrajero instalando manijón y cerrojo de seguridad en puerta de madera de interior en ${nombreZona}`,
        etiqueta: 'Cambio de cerraduras y herrajes',
        mediaUrl: galeria3.src
    }
];

// Responsive images: la tarjeta mide ~50vw (mobile), ~33vw (tablet) y ~350px (desktop) con proporción 4/5.
// Con object-cover, una imagen más apaisada que 4/5 se renderiza más ancha que la tarjeta, así que escalamos `sizes`.
const anchosBase = [360, 540, 720, 1080];
const responsive = (img: ImageMetadata) => {
    const factor = Math.max(1, 1.25 * (img.width / img.height));
    const px = (n: number) => Math.round(n * factor);
    return {
        widths: [...anchosBase.filter((w) => w < img.width), img.width],
        sizes: `(min-width: 1152px) ${px(350)}px, (min-width: 768px) ${px(33)}vw, ${px(50)}vw`,
    };
};
---

<section id="trabajos" class="py-20 md:py-28 bg-fondo-base border-t border-borde relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Encabezado -->
        <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
            <h2 class="text-3xl md:text-5xl font-black text-white leading-tight tracking-tight mb-4">
                Galería de nuestros <span class="text-marca">Trabajos Realizados</span>
            </h2>
            <p class="text-gray-400 text-base md:text-xl font-medium">
                Sin fotos de archivo. Así resolvemos urgencias todos los días.
            </p>
        </div>

        <!-- Grid Compacto: 2 columnas en mobile, 3 en desktop. Proporción 4/5 -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-5">
            <!-- Cada trabajo es un <button> para que se pueda abrir también con el teclado -->
            {trabajos.map((item) => (
                <button
                    type="button"
                    class="item-galeria relative block w-full text-left aspect-[4/5] rounded-xl md:rounded-2xl overflow-hidden group cursor-pointer border border-borde/50 hover:border-marca shadow-lg bg-fondo-nav transition-all duration-300"
                    data-tipo={item.tipo}
                    data-url={item.mediaUrl}
                    aria-label={`${item.tipo === 'video' ? 'Ver video' : 'Ampliar foto'}: ${item.etiqueta}`}
                >
                    <!-- Portada / Imagen -->
                    <Image
                        src={item.src}
                        alt={item.alt}
                        {...responsive(item.src)}
                        class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />

                    <!-- Overlay Oscuro -->
                    <span class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity"></span>

                    <!-- Etiqueta del Trabajo -->
                    <span class="absolute bottom-3 left-3 right-3 md:bottom-4 md:left-4 md:right-4">
                        <span class="block truncate text-white text-[11px] md:text-sm font-bold tracking-wide drop-shadow-md">
                            {item.etiqueta}
                        </span>
                    </span>

                    <!-- Botón Play superpuesto si es Video (Restaurado para UX visual) -->
                    {item.tipo === 'video' && (
                        <span class="absolute inset-0 flex items-center justify-center pointer-events-none">
                            <span class="w-10 h-10 md:w-14 md:h-14 bg-marca/90 backdrop-blur-md rounded-full flex items-center justify-center text-white shadow-[0_0_15px_rgba(14,165,233,0.4)] group-hover:scale-110 transition-transform">
                                <svg class="w-5 h-5 md:w-6 md:h-6 ml-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                            </span>
                        </span>
                    )}
                </button>
            ))}
        </div>

    </div>

    <!-- Lightbox Modal (HTML5 Nativo) -->
    <dialog id="lightbox-modal" class="bg-transparent m-0 p-0 w-full h-full max-w-none backdrop:bg-black/95 backdrop:backdrop-blur-sm open:flex justify-center items-center">
        
        <!-- Botón Cerrar (X Gigante) -->
        <button id="btn-cerrar-lightbox" type="button" aria-label="Cerrar" class="absolute top-4 right-4 md:top-8 md:right-8 z-50 p-2 text-white/70 hover:text-white hover:rotate-90 transition-all focus:outline-none bg-black/50 rounded-full backdrop-blur-md border border-white/10">
            <svg class="w-10 h-10 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
        
        <!-- Contenedor Dinámico -->
        <div class="relative w-full h-full flex justify-center items-center p-4">
            
            <!-- Elemento Imagen -->
            <img id="lightbox-img" class="hidden max-h-[85vh] max-w-[95vw] object-contain rounded-xl shadow-2xl" alt="Trabajo realizado" />
            
            <!-- Elemento Video -->
            <video id="lightbox-video" class="hidden max-h-[85vh] max-w-[95vw] object-contain rounded-xl shadow-2xl bg-black" controls playsinline>
                Tu navegador no soporta videos.
            </video>

        </div>
    </dialog>
</section>

<script>
    const modal = document.getElementById('lightbox-modal') as HTMLDialogElement;
    const imgElement = document.getElementById('lightbox-img') as HTMLImageElement;
    const videoElement = document.getElementById('lightbox-video') as HTMLVideoElement;
    const btnCerrar = document.getElementById('btn-cerrar-lightbox');
    const itemsGaleria = document.querySelectorAll('.item-galeria');

    // Asignar eventos de manera limpia usando Data Attributes
    itemsGaleria.forEach(item => {
        item.addEventListener('click', () => {
            const tipo = item.getAttribute('data-tipo');
            const url = item.getAttribute('data-url');

            if (!modal || !url) return;

            if (tipo === 'foto') {
                videoElement.classList.add('hidden');
                videoElement.pause();
                imgElement.src = url;
                imgElement.alt = item.querySelector('img')?.alt ?? 'Trabajo realizado';
                imgElement.classList.remove('hidden');
            } else if (tipo === 'video') {
                imgElement.classList.add('hidden');
                videoElement.src = url;
                videoElement.classList.remove('hidden');
                videoElement.play();
            }

            modal.showModal();
            // Prevenir scroll en el body mientras el modal está abierto
            document.body.style.overflow = 'hidden';
        });
    });

    const cerrarLightbox = () => {
        if (!modal) return;
        modal.close(); // La limpieza se hace en el evento 'close'
    };

    // 'close' se dispara siempre: botón X, clic en el fondo o tecla Escape
    modal?.addEventListener('close', () => {
        videoElement.pause();
        videoElement.removeAttribute('src');
        videoElement.load();
        imgElement.removeAttribute('src');
        document.body.style.overflow = '';
    });

    if (btnCerrar) {
        btnCerrar.addEventListener('click', cerrarLightbox);
    }

    // Cerrar al hacer clic en el fondo oscuro
    if (modal) {
        modal.addEventListener('click', (e) => {
            if (e.target === modal || e.target === modal.firstElementChild) {
                cerrarLightbox();
            }
        });
    }
</script>